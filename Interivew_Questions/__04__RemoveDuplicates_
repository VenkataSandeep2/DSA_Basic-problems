package com.InterviewQuestions;

import java.util.Arrays;

public class __04__RemoveDuplicates_
{
	    public static void main(String[] args) 
	    {
	        int[] arr = {10,20,30,50,30,80,10,5,6,15,10,10};

	        // Java 8 Featuures on Streans 
	        
	        int[] uniquearray = Arrays.stream(arr).distinct().toArray();
	        System.out.println();
	        
	        System.out.println("Original: " + Arrays.toString(arr));
	        System.out.println("Unique:   " + Arrays.toString(uniquearray));
	        System.out.println("Size:     " + uniquearray.length);
	    }
}
